@@ -0,0 +1,24 @@
+from __future__ import annotations
+
+import hashlib
+import hmac
+from secrets import token_urlsafe
+
+
+def generate_token_secret() -> str:
+    """Return a new random token secret (256 bits of entropy)."""
+    return token_urlsafe(32)
+
+
+def hash_token_secret(secret: str) -> str:
+    """Return the hex SHA-256 digest of a token secret, suitable for storage.
+
+    API token secrets are long random values, not user-chosen passwords, so a
+    fast unsalted hash is appropriate (and allows lookup by digest).
+    """
+    return hashlib.sha256(secret.encode()).hexdigest()
+
+
+def verify_token_secret(secret: str, stored_hash: str) -> bool:
+    """Check a presented secret against a stored digest in constant time."""
+    return hmac.compare_digest(hash_token_secret(secret), stored_hash)
