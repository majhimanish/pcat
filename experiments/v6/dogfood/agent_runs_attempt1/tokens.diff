+from __future__ import annotations
+
+from django.test import TestCase
+
+from hc.lib.tokens import generate_token_secret, hash_token_secret, verify_token_secret
+
+
+class TokensTestCase(TestCase):
+    def test_roundtrip(self) -> None:
+        secret = generate_token_secret()
+        hashed = hash_token_secret(secret)
+        self.assertNotIn(secret, hashed)
+        self.assertTrue(verify_token_secret(secret, hashed))
+
+    def test_wrong_secret_fails(self) -> None:
+        hashed = hash_token_secret("correct")
+        self.assertFalse(verify_token_secret("wrong", hashed))
+
+    def test_hashes_are_salted(self) -> None:
+        self.assertNotEqual(hash_token_secret("x"), hash_token_secret("x"))
+
+    def test_empty_inputs(self) -> None:
+        with self.assertRaises(ValueError):
+            hash_token_secret("")
+        self.assertFalse(verify_token_secret("", hash_token_secret("x")))
+        self.assertFalse(verify_token_secret("x", ""))
+
+    def test_secrets_are_unique(self) -> None:
+        self.assertNotEqual(generate_token_secret(), generate_token_secret())
