@@ -0,0 +1,24 @@
+from __future__ import annotations
+
+from secrets import token_urlsafe
+
+from django.contrib.auth.hashers import check_password, make_password
+
+
+def generate_token_secret() -> str:
+    """Return a new random API token secret (shown to the user once)."""
+    return token_urlsafe(32)
+
+
+def hash_token_secret(secret: str) -> str:
+    """Hash an API token secret for storage. Never store the plain secret."""
+    if not secret:
+        raise ValueError("secret must not be empty")
+    return make_password(secret)
+
+
+def verify_token_secret(secret: str, hashed: str) -> bool:
+    """Check a presented secret against a stored hash (constant-time)."""
+    if not secret or not hashed:
+        return False
+    return check_password(secret, hashed)
