+def authorize_read(f: ViewFunc) -> ViewFunc:
+    """Authorize a read-only endpoint using a read-write or read-only API key.
+
+    The key must be sent in the X-Api-Key request header. Sets request.readonly
+    to True if the key was a read-only key.
+    """
+
+    @wraps(f)
+    def wrapper(request: ApiRequest, *args: Any, **kwds: Any) -> HttpResponse:
+        request.json = {}
+
+        api_key = request.headers.get("X-Api-Key", "")
+        if len(api_key) != 32 and not api_key.startswith(("hcw_", "hcr_")):
+            return error("missing api key", 401)
+
+        # Try the read-write key first, then the read-only key. Doing two
+        # lookups lets us tell which kind of key matched.
+        readonly = False
+        project = Project.objects.for_api_key(api_key, accept_rw=True, accept_ro=False)
+        if project is None:
+            readonly = True
+            project = Project.objects.for_api_key(
+                api_key, accept_rw=False, accept_ro=True
+            )
+        if project is None:
+            return error("wrong api key", 401)
+
+        request.project = project
+        request.readonly = readonly
+        request.v = _get_api_version(request)
+        return f(request, *args, **kwds)
+
+    return wrapper
+
+
