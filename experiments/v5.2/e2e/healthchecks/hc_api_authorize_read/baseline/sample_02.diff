+def authorize_read(f: ViewFunc) -> ViewFunc:
+    """Accept either a read-write or a read-only project API key (X-Api-Key)."""
+
+    @wraps(f)
+    def wrapper(request: ApiRequest, *args: Any, **kwds: Any) -> HttpResponse:
+        api_key = request.headers.get("X-Api-Key", "")
+        if not api_key:
+            return error("missing api key", 401)
+
+        project = Project.objects.for_api_key(api_key, accept_rw=True, accept_ro=True)
+        if project is None:
+            return error("wrong api key", 401)
+
+        request.project = project
+        # Read-only if the key matches the project's read-only key
+        # (hashed read-only keys are prefixed "hcr_"; plain ones are compared directly)
+        request.readonly = api_key.startswith("hcr_") or (
+            project.api_key_readonly == api_key
+        )
+        request.v = _get_api_version(request)
+        return f(request, *args, **kwds)
+
+    return wrapper
+
+
