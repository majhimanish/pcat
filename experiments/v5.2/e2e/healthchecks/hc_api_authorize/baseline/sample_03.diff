+def authorize(f: ViewFunc) -> ViewFunc:
+    """Authorize a write endpoint using a read-write project API key.
+
+    The key is read from the X-Api-Key header, or from the "api_key" field
+    of a JSON request body. The parsed body is exposed as `request.json`.
+    Read-only keys are rejected.
+    """
+
+    @wraps(f)
+    def wrapper(request: ApiRequest, *args: Any, **kwds: Any) -> HttpResponse:
+        request.json = {}
+        if request.body:
+            try:
+                parsed = json.loads(request.body.decode())
+            except ValueError:
+                return error("could not parse request body")
+
+            if not isinstance(parsed, dict):
+                return error("json validation error: value is not an object")
+
+            request.json = parsed
+
+        api_key = request.headers.get("X-Api-Key", "")
+        if not api_key:
+            body_key = request.json.get("api_key", "")
+            api_key = body_key if isinstance(body_key, str) else ""
+
+        if len(api_key) != 32:
+            return error("missing api key", 401)
+
+        project = Project.objects.for_api_key(api_key, accept_rw=True, accept_ro=False)
+        if project is None:
+            return error("wrong api key", 401)
+
+        request.project = project
+        request.readonly = False
+        request.v = _get_api_version(request)
+        return f(request, *args, **kwds)
+
+    return wrapper
+
+
