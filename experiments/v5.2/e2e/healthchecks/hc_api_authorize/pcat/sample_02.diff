+def authorize(f: ViewFunc) -> ViewFunc:
+    """Authorize write endpoints with a read-write project API key.
+
+    The key is read from the X-Api-Key header or, failing that, from the
+    "api_key" field of the JSON request body. The header takes precedence.
+    """
+
+    @wraps(f)
+    def wrapper(request: ApiRequest, *args: Any, **kwds: Any) -> HttpResponse:
+        api_key = ""
+        request.json = {}
+        if request.method == "POST" and request.body:
+            try:
+                data = json.loads(request.body.decode())
+            except ValueError:
+                return error("could not parse request body", 400)
+
+            if not isinstance(data, dict):
+                return error("json validation error: value is not an object", 400)
+
+            request.json = data
+            body_key = data.get("api_key", "")
+            if isinstance(body_key, str):
+                api_key = body_key
+
+        if "X-Api-Key" in request.headers:
+            api_key = request.headers["X-Api-Key"]
+
+        if len(api_key) != 32:
+            return error("missing api key", 401)
+
+        project = Project.objects.for_api_key(api_key, accept_rw=True, accept_ro=False)
+        if project is None:
+            return error("wrong api key", 401)
+
+        request.project = project
+        request.readonly = False
+        request.v = _get_api_version(request)
+        return f(request, *args, **kwds)
+
+    return wrapper
+
+
 def cors(*methods: str) -> Callable[[ViewFunc], ViewFunc]:
     methods_set = set(methods)
     methods_set.add("OPTIONS")
