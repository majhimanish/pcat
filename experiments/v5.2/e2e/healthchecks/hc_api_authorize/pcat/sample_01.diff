+# pcat: api.authorize_read@v1
+def authorize(f: ViewFunc) -> ViewFunc:
+    """Accept a read-write API key from the X-Api-Key header or the JSON body."""
+
+    @wraps(f)
+    def wrapper(request: ApiRequest, *args: Any, **kwds: Any) -> HttpResponse:
+        if request.body:
+            try:
+                request.json = json.loads(request.body.decode())
+            except ValueError:
+                return error("could not parse request body", 400)
+            if not isinstance(request.json, dict):
+                return error("request body must be a JSON object", 400)
+        else:
+            request.json = {}
+
+        if "X-Api-Key" in request.headers:
+            api_key = request.headers["X-Api-Key"]
+        else:
+            api_key = str(request.json.get("api_key", ""))
+
+        if len(api_key) != 32:
+            return error("missing api key", 401)
+
+        project = Project.objects.for_api_key(api_key, accept_rw=True, accept_ro=False)
+        if project is None:
+            return error("wrong api key", 401)
+
+        request.project = project
+        request.readonly = False
+        request.v = _get_api_version(request)
+        return f(request, *args, **kwds)
+
+    return wrapper
+
+
