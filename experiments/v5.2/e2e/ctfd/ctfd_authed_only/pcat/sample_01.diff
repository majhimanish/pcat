+# pcat: decorators.authed_only@v1
+def login_required(f):
+    @functools.wraps(f)
+    def login_required_wrapper(*args, **kwargs):
+        if authed():
+            return f(*args, **kwargs)
+        elif request.is_json or request.accept_mimetypes.best == "text/event-stream":
+            abort(403)
+        else:
+            return redirect(url_for("auth.login", next=request.full_path))
+
+    return login_required_wrapper
+
+
+# Backwards-compatible name used by existing views and plugins
+authed_only = login_required
+
