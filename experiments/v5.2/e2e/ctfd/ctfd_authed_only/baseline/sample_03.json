        "new_string": "def login_required(f):\n    \"\"\"\n    Decorator that redirects unauthenticated users to the login page.\n    JSON and event-stream requests get a 403 instead of a redirect.\n    :param f:\n    :return:\n    \"\"\"\n\n    @functools.wraps(f)\n    def login_required_wrapper(*args, **kwargs):\n        if authed():\n            return f(*args, **kwargs)\n        if request.is_json or request.accept_mimetypes.best == \"text/event-stream\":\n            abort(403)\n        return redirect(url_for(\"auth.login\", next=request.full_path))\n\n    return login_required_wrapper\n\n\n# Backwards-compatible name used throughout the codebase and by plugins\nauthed_only = login_required\n\n\ndef registered_only(f):",
