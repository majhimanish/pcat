@@ -99,6 +99,29 @@ def api_authed_only(f):
     return api_authed_only_wrapper
 
 
+def login_required(f):
+    """
+    Decorator that redirects unauthenticated users to the login page.
+    JSON and event-stream requests get a 403 instead of a redirect.
+    :param f:
+    :return:
+    """
+
+    @functools.wraps(f)
+    def login_required_wrapper(*args, **kwargs):
+        if authed():
+            return f(*args, **kwargs)
+        if request.is_json or request.accept_mimetypes.best == "text/event-stream":
+            abort(403)
+        return redirect(url_for("auth.login", next=request.full_path))
+
+    return login_required_wrapper
+
+
+# Backwards-compatible name used throughout the codebase and by plugins
+authed_only = login_required
+
+
