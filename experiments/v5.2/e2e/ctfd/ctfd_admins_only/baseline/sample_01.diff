+def admins_only(f):
+    """
+    Decorator that requires the user to be an admin. Non-admins are redirected
+    to the login page (or receive a 403 for JSON/event-stream requests).
+    :param f:
+    :return:
+    """
+
+    @functools.wraps(f)
+    def admins_only_wrapper(*args, **kwargs):
+        if is_admin():
+            return f(*args, **kwargs)
+        else:
+            if request.is_json or request.accept_mimetypes.best == "text/event-stream":
+                abort(403)
+            else:
+                return redirect(url_for("auth.login", next=request.full_path))
+
+    return admins_only_wrapper
+
+
