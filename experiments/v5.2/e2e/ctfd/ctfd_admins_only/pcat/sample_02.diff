+def admins_only(f):
+    @functools.wraps(f)
+    def admins_only_wrapper(*args, **kwargs):
+        if is_admin():
+            return f(*args, **kwargs)
+        elif request.is_json:
+            abort(403)
+        else:
+            return redirect(url_for("auth.login", next=request.full_path))
+
+    return admins_only_wrapper
