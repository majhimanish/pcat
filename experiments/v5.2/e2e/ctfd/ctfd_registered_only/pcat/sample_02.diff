+# pcat: decorators.authed_only@v1
+def authed_only_register(f):
+    """
+    Decorator that requires the user to be authenticated, redirecting
+    anonymous users to the registration page instead of login
+    :param f:
+    :return:
+    """
+
+    @functools.wraps(f)
+    def authed_only_register_wrapper(*args, **kwargs):
+        if authed():
+            return f(*args, **kwargs)
+        elif request.is_json or request.accept_mimetypes.best == "text/event-stream":
+            abort(403)
+        else:
+            return redirect(url_for("auth.register", next=request.full_path))
+
+    return authed_only_register_wrapper
+
