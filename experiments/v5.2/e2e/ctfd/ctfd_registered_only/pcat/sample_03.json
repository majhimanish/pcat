        "new_string": "# pcat: decorators.authed_only@v1\ndef authed_or_register(f):\n    \"\"\"\n    Decorator that requires the user to be authenticated, sending\n    anonymous users to the registration page instead of login\n    :param f:\n    :return:\n    \"\"\"\n\n    @functools.wraps(f)\n    def authed_or_register_wrapper(*args, **kwargs):\n        if authed():\n            return f(*args, **kwargs)\n        elif request.is_json or request.accept_mimetypes.best == \"text/event-stream\":\n            abort(403)\n        else:\n            return redirect(url_for(\"auth.register\", next=request.full_path))\n\n    return authed_or_register_wrapper\n\n\ndef members_only(f):",
