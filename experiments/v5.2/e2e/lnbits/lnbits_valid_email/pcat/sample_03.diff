+# pcat: validators.regex_match@v1
+def is_valid_email(email: str) -> bool:
+    email_regex = r"[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}"
+    return re.fullmatch(email_regex, email) is not None
+
+
+# existing callers import this name
+is_valid_email_address = is_valid_email
+
+
 def is_valid_label(label: str) -> bool:
     label_regex = r"([A-Za-z0-9 ._-]{1,100}$)"
     return re.fullmatch(label_regex, label) is not None
