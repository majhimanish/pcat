+    email_regex = r"[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}"
+    return len(email) <= 254 and re.fullmatch(email_regex, email) is not None
