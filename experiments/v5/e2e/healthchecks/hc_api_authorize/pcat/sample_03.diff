@@ -55,6 +55,46 @@ def authorize_read(f: ViewFunc) -> ViewFunc:
     return wrapper
 
 
+# pcat: api.authorize_read@v1
+def authorize_write(f: ViewFunc) -> ViewFunc:
+    """Require the read-write project API key.
+
+    The key is taken from the X-Api-Key header, or from the "api_key" field of
+    the JSON request body. Read-only keys are rejected.
+    """
+
+    @wraps(f)
+    def wrapper(request: ApiRequest, *args: Any, **kwds: Any) -> HttpResponse:
+        request.json = {}
+        if request.body:
+            try:
+                parsed = json.loads(request.body.decode())
+            except ValueError:
+                return error("could not parse request body")
+            if not isinstance(parsed, dict):
+                return error("json validation error: body must be an object")
+            request.json = parsed
+
+        if "X-Api-Key" in request.headers:
+            api_key = request.headers["X-Api-Key"]
+        else:
+            api_key = request.json.get("api_key", "")
+
+        if not isinstance(api_key, str) or len(api_key) != 32:
+            return error("missing api key", 401)
+
+        project = Project.objects.for_api_key(api_key, accept_rw=True, accept_ro=False)
+        if project is None:
+            return error("wrong api key", 401)
+
+        request.project = project
+        request.readonly = False
+        request.v = _get_api_version(request)
+        return f(request, *args, **kwds)
+
+    return wrapper
+
+
 def cors(*methods: str) -> Callable[[ViewFunc], ViewFunc]:
     methods_set = set(methods)
     methods_set.add("OPTIONS")
