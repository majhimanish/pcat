     return f"{secs} second{pluralize(secs)}"
 
 
+def format_timedelta(duration: timedelta) -> str:
+    """Format as e.g. "2 hours 30 minutes" or "8 days".
+
+    Shows the largest non-zero unit and the next smaller unit (if non-zero).
+    """
+    total_seconds = int(duration.total_seconds())
+
+    mins, secs = divmod(total_seconds, 60)
+    hours, mins = divmod(mins, 60)
+    days, hours = divmod(hours, 24)
+
+    parts = [(days, DAY), (hours, HOUR), (mins, MINUTE), (secs, SECOND)]
+    for i, (value, unit) in enumerate(parts):
+        if value:
+            result = f"{value} {unit.name}{pluralize(value)}"
+            if i + 1 < len(parts):
+                next_value, next_unit = parts[i + 1]
+                if next_value:
+                    result += f" {next_value} {next_unit.name}{pluralize(next_value)}"
+            return result
+
+    return "0 seconds"
+
+
