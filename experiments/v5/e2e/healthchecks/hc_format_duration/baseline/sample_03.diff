+class FormatTimedeltaTestCase(TestCase):
+    def test_it_works(self) -> None:
+        samples = [
+            (td(days=8), "8 days"),
+            (td(days=1), "1 day"),
+            (td(days=2, hours=3), "2 days 3 hours"),
+            (td(days=1, hours=1, minutes=30), "1 day 1 hour"),
+            (td(days=1, minutes=5), "1 day"),
+            (td(hours=2, minutes=30), "2 hours 30 minutes"),
+            (td(hours=1), "1 hour"),
+            (td(minutes=1, seconds=1), "1 minute 1 second"),
+            (td(seconds=45), "45 seconds"),
+            (td(0), "0 seconds"),
+        ]
+
+        for duration, expected in samples:
+            self.assertEqual(format_timedelta(duration), expected)
