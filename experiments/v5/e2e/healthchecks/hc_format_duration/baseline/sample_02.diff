+class DurationWordsTestCase(TestCase):
+    def test_it_works(self) -> None:
+        samples = [
+            (td(days=8), "8 days"),
+            (td(days=8, minutes=30), "8 days"),
+            (td(days=1, hours=1), "1 day 1 hour"),
+            (td(days=3, hours=6, minutes=12), "3 days 6 hours"),
+            (td(hours=2, minutes=30), "2 hours 30 minutes"),
+            (td(hours=1, minutes=1, seconds=5), "1 hour 1 minute"),
+            (td(hours=2), "2 hours"),
+            (td(minutes=5, seconds=10), "5 minutes 10 seconds"),
+            (td(seconds=1), "1 second"),
+            (td(0), "0 seconds"),
+        ]
+
+        for duration, expected in samples:
+            self.assertEqual(format_duration_words(duration), expected)
