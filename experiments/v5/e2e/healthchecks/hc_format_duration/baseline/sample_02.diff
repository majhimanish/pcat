+def format_duration_words(duration: timedelta) -> str:
+    """Format a timedelta using its two most significant units.
+
+    Zero-valued units are omitted: "2 hours 30 minutes", "8 days".
+    """
+    total_seconds = int(duration.total_seconds())
+
+    mins, secs = divmod(total_seconds, 60)
+    hours, mins = divmod(mins, 60)
+    days, hours = divmod(hours, 24)
+
+    units = [(days, "day"), (hours, "hour"), (mins, "minute"), (secs, "second")]
+    for i, (value, _) in enumerate(units):
+        if value:
+            parts = [
+                f"{v} {name}{pluralize(v)}" for v, name in units[i : i + 2] if v
+            ]
+            return " ".join(parts)
+
+    return "0 seconds"
+
