+def format_duration_words(duration: timedelta) -> str:
+    """Format a duration like "2 hours 30 minutes" or "8 days".
+
+    Uses the two most significant units, starting from the largest non-zero one,
+    and omits the second unit if its value is zero.
+    """
+
+    total_seconds = int(duration.total_seconds())
+
+    mins, secs = divmod(total_seconds, 60)
+    hours, mins = divmod(mins, 60)
+    days, hours = divmod(hours, 24)
+
+    parts = [(days, "day"), (hours, "hour"), (mins, "minute"), (secs, "second")]
+    for i, (value, _) in enumerate(parts):
+        if value:
+            parts = parts[i : i + 2]
+            break
+    else:
+        return "0 seconds"
+
+    return " ".join(f"{v} {name}{pluralize(v)}" for v, name in parts if v)
+
+
