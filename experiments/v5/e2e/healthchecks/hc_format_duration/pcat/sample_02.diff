+def format_duration_words(duration: timedelta) -> str:
+    """Format a timedelta as e.g. "2 hours 30 minutes" or "8 days".
+
+    Shows at most two units, starting from the largest non-zero one
+    (days, hours, minutes, seconds). Zero-valued units are skipped.
+    """
+    remaining = int(duration.total_seconds())
+    if remaining < 0:
+        return "-" + format_duration_words(-duration)
+
+    parts = []
+    for unit in (DAY, HOUR, MINUTE, SECOND):
+        value, remaining = divmod(remaining, unit.nsecs)
+        if value:
+            parts.append(f"{value} {unit.name if value == 1 else unit.plural}")
+
+    if not parts:
+        return f"0 {SECOND.plural}"
+
+    return " ".join(parts[:2])
+
+
