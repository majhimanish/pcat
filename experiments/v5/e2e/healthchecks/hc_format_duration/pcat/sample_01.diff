     return f"{secs} second{pluralize(secs)}"
 
 
+def format_duration_words(duration: timedelta) -> str:
+    """Format a duration as e.g. "2 hours 30 minutes" or "8 days".
+
+    Zero-valued units are omitted and at most the two largest non-zero
+    units are shown. The sign is ignored (the absolute value is used).
+    """
+    total_seconds = abs(int(duration.total_seconds()))
+
+    days, rem = divmod(total_seconds, DAY.nsecs)
+    hours, rem = divmod(rem, HOUR.nsecs)
+    mins, secs = divmod(rem, MINUTE.nsecs)
+
+    parts = []
+    for value, unit in ((days, DAY), (hours, HOUR), (mins, MINUTE), (secs, SECOND)):
+        if value:
+            parts.append(f"{value} {unit.name if value == 1 else unit.plural}")
+
+    if not parts:
+        return f"0 {SECOND.plural}"
+
+    return " ".join(parts[:2])
+
+
