+            (td(days=8), "8 days"),
+            (td(days=1), "1 day"),
+            (td(days=8, hours=3, minutes=5), "8 days 3 hours"),
+            (td(days=1, minutes=5), "1 day 5 minutes"),
+            (td(hours=1), "1 hour"),
+            (td(minutes=1, seconds=1), "1 minute 1 second"),
+            (td(seconds=12), "12 seconds"),
+            (td(0), "0 seconds"),
+            (td(milliseconds=500), "0 seconds"),
+            (td(hours=-2, minutes=-30), "2 hours 30 minutes"),
+        ]
+
+        for duration, expected in samples:
+            self.assertEqual(format_duration_words(duration), expected)
