+def format_duration_words(duration: timedelta) -> str:
+    """Format a duration as e.g. "2 hours 30 minutes" or "8 days".
+
+    Uses the largest non-zero unit plus the next smaller unit (if non-zero).
+    Durations under a minute are shown in seconds.
+    """
+
+    total_seconds = max(int(duration.total_seconds()), 0)
+
+    mins, secs = divmod(total_seconds, 60)
+    hours, mins = divmod(mins, 60)
+    days, hours = divmod(hours, 24)
+
+    parts = [(days, DAY), (hours, HOUR), (mins, MINUTE), (secs, SECOND)]
+    for i, (value, unit) in enumerate(parts):
+        if value:
+            result = [f"{value} {unit.name if value == 1 else unit.plural}"]
+            if i + 1 < len(parts) and parts[i + 1][0]:
+                nvalue, nunit = parts[i + 1]
+                result.append(f"{nvalue} {nunit.name if nvalue == 1 else nunit.plural}")
+            return " ".join(result)
+
+    return "0 seconds"
+
+
