@@ -10,3 +10,16 @@ from django.http import HttpRequest, HttpResponse
 from hc.lib.typealias import ViewFunc
 
 
+def require_setting(setting_name: str) -> Callable[[ViewFunc], ViewFunc]:
+    """Return a 404 response unless the named Django setting is truthy."""
+
+    def decorator(f: ViewFunc) -> ViewFunc:
+        @wraps(f)
+        def wrapper(request: HttpRequest, *args: Any, **kwargs: Any) -> HttpResponse:
+            if not getattr(settings, setting_name, None):
+                return HttpResponse(status=404)
+            return f(request, *args, **kwargs)
+
+        return wrapper
+
+    return decorator
