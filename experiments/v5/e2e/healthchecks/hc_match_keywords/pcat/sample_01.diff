+def contains_any_keyword(text: str, keywords: str) -> bool:
+    """Return True if any comma-separated keyword appears in text.
+
+    Matching is case-insensitive. Whitespace around keywords is stripped
+    and empty keywords are ignored.
+
+    >>> contains_any_keyword("Server is down", "down, offline")
+    True
+    >>> contains_any_keyword("All good", "down, offline")
+    False
+
+    """
+
+    haystack = text.lower()
+    for keyword in keywords.split(","):
+        keyword = keyword.strip().lower()
+        if keyword and keyword in haystack:
+            return True
+
+    return False
+
+
