+
+    def test_contains_any_keyword_matches(self) -> None:
+        self.assertTrue(contains_any_keyword("Backup failed", "error, failed"))
+
+    def test_contains_any_keyword_is_case_insensitive(self) -> None:
+        self.assertTrue(contains_any_keyword("BACKUP FAILED", "failed"))
+
+    def test_contains_any_keyword_returns_false_on_no_match(self) -> None:
+        self.assertFalse(contains_any_keyword("All good", "error, failed"))
+
+    def test_contains_any_keyword_ignores_empty_keywords(self) -> None:
+        self.assertFalse(contains_any_keyword("All good", ""))
+        self.assertFalse(contains_any_keyword("All good", " , ,"))
