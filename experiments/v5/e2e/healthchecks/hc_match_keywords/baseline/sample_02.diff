+
+    def test_contains_any_keyword_matches(self) -> None:
+        self.assertTrue(contains_any_keyword("Disk is full", "cpu, disk"))
+
+    def test_contains_any_keyword_is_case_insensitive(self) -> None:
+        self.assertTrue(contains_any_keyword("Disk is full", "DISK"))
+
+    def test_contains_any_keyword_no_match(self) -> None:
+        self.assertFalse(contains_any_keyword("Disk is full", "cpu,memory"))
+
+    def test_contains_any_keyword_ignores_empty_keywords(self) -> None:
+        self.assertFalse(contains_any_keyword("anything", ""))
+        self.assertFalse(contains_any_keyword("anything", " , ,"))
