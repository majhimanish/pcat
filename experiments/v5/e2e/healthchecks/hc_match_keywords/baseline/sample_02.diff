     return bool(uuid_match_regex.match(value))
 
 
+def contains_any_keyword(text: str, keywords: str) -> bool:
+    """Return True if any keyword from a comma-separated list appears in text.
+
+    Matching is a case-insensitive substring search. Whitespace around
+    keywords is stripped and empty keywords are ignored.
+
+    >>> contains_any_keyword("Disk is full", "cpu, DISK")
+    True
+
+    """
+
+    haystack = text.lower()
+    for keyword in keywords.split(","):
+        keyword = keyword.strip().lower()
+        if keyword and keyword in haystack:
+            return True
+
+    return False
+
