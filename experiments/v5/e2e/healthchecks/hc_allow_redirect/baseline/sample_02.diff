@@ -56,6 +56,32 @@ POST_LOGIN_ROUTES = (
 )
 
 
+def _allow_redirect(redirect_url: str | None) -> bool:
+    """Return True if redirect_url is a safe post-login destination.
+
+    Only relative, same-site paths that resolve to one of POST_LOGIN_ROUTES
+    are allowed. Absolute URLs, scheme-relative URLs ("//evil.com") and
+    backslash tricks are rejected.
+    """
+
+    if not redirect_url or "\\" in redirect_url:
+        return False
+
+    parsed = urlparse(redirect_url)
+    if parsed.scheme or parsed.netloc:
+        return False
+
+    if not parsed.path.startswith("/") or parsed.path.startswith("//"):
+        return False
+
+    try:
+        match = resolve(parsed.path)
+    except Resolver404:
+        return False
+
+    return match.url_name in POST_LOGIN_ROUTES
+
+
