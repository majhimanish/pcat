+def camel_to_snake(value: str) -> str:
+    """Convert camelCase/PascalCase to snake_case (e.g. "hostJsName" -> "host_js_name")."""
+    value = re.sub(r"(.)([A-Z][a-z]+)", r"\1_\2", value)
+    return re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", value).lower()
