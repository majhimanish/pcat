+def is_lnbits_version_ok(
+    min_lnbits_version: str | None, max_lnbits_version: str | None
+) -> bool:
+    """
+    Check if the running LNbits version is within the optional range.
+    `min_lnbits_version` is inclusive, `max_lnbits_version` is exclusive.
+    """
+    current = version_parse(settings.version)
+    if min_lnbits_version and current < version_parse(min_lnbits_version):
+        return False
+    if max_lnbits_version and current >= version_parse(max_lnbits_version):
+        return False
+    return True
+
