+def create_access_token(
+    data: dict, token_expire_minutes: int | None = None
+) -> str:
+    """
+    Create a signed JWT access token.
+
+    Args:
+        data: Claims to include; keys with `None` values are omitted
+        token_expire_minutes: Token lifetime, defaults to
+            `settings.auth_token_expire_minutes`
+    """
+    minutes = token_expire_minutes or settings.auth_token_expire_minutes
+    expire = datetime.now(timezone.utc) + timedelta(minutes=minutes)
+    to_encode = {k: v for k, v in data.items() if v is not None}
+    to_encode.update({"exp": expire})
+    return jwt.encode(to_encode, settings.auth_secret_key, "HS256")
+
