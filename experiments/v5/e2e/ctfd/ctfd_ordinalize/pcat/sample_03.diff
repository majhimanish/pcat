diff --git a/CTFd/utils/humanize/numbers.py b/CTFd/utils/humanize/numbers.py
index 8b13789..cb2645b 100644
--- a/CTFd/utils/humanize/numbers.py
+++ b/CTFd/utils/humanize/numbers.py
@@ -1 +1,11 @@
-
+def ordinalize(n):
+    """
+    Return an integer with its English ordinal suffix: 1st, 2nd, 3rd, 4th, 11th.
+    11, 12 and 13 (and 111-113, etc.) always take "th".
+    """
+    n = int(n)
+    if 10 <= abs(n) % 100 <= 20:
+        suffix = "th"
+    else:
+        suffix = {1: "st", 2: "nd", 3: "rd"}.get(abs(n) % 10, "th")
+    return "{}{}".format(n, suffix)
