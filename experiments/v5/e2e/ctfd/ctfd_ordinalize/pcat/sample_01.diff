diff --git a/CTFd/utils/humanize/numbers.py b/CTFd/utils/humanize/numbers.py
index 8b13789..452ebb4 100644
--- a/CTFd/utils/humanize/numbers.py
+++ b/CTFd/utils/humanize/numbers.py
@@ -1 +1,10 @@
-
+def ordinalize(n):
+    """
+    Return an integer with its English ordinal suffix, e.g. 1st, 2nd, 3rd, 11th.
+    """
+    n = int(n)
+    if 10 <= abs(n) % 100 <= 20:
+        suffix = "th"
+    else:
+        suffix = {1: "st", 2: "nd", 3: "rd"}.get(abs(n) % 10, "th")
+    return "{}{}".format(n, suffix)
