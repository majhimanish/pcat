         12: "12th",
         13: "13th",
+        14: "14th",
+        20: "20th",
+        21: "21st",
+        22: "22nd",
+        23: "23rd",
+        100: "100th",
         101: "101st",
         102: "102nd",
         103: "103rd",
         111: "111th",
+        112: "112th",
+        113: "113th",
+        121: "121st",
