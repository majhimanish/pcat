+
+
+def test_ordinalize_teens_and_edges():
+    tests = {
+        0: "0th",
+        10: "10th",
+        20: "20th",
+        21: "21st",
+        22: "22nd",
+        23: "23rd",
+        100: "100th",
+        112: "112th",
+        113: "113th",
+        211: "211th",
+        1011: "1011th",
+        1021: "1021st",
+        "5": "5th",
+    }
+    for t, v in tests.items():
+        assert ordinalize(t) == v
