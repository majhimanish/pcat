index 8b13789..43b82d6 100644
--- a/CTFd/utils/humanize/numbers.py
+++ b/CTFd/utils/humanize/numbers.py
@@ -1 +1,8 @@
-
+def ordinalize(n):
+    """Return n with its English ordinal suffix: 1st, 2nd, 3rd, 4th, 11th..."""
+    n = int(n)
+    if 11 <= abs(n) % 100 <= 13:
+        suffix = "th"
+    else:
+        suffix = {1: "st", 2: "nd", 3: "rd"}.get(abs(n) % 10, "th")
+    return "{}{}".format(n, suffix)
