index 8b13789..df8bffc 100644
--- a/CTFd/utils/humanize/numbers.py
+++ b/CTFd/utils/humanize/numbers.py
@@ -1 +1,8 @@
-
+def ordinalize(n):
+    """Return n with its English ordinal suffix, e.g. 1 -> "1st", 11 -> "11th"."""
+    n = int(n)
+    if 10 <= abs(n) % 100 <= 20:
+        suffix = "th"
+    else:
+        suffix = {1: "st", 2: "nd", 3: "rd"}.get(abs(n) % 10, "th")
+    return "{}{}".format(n, suffix)
