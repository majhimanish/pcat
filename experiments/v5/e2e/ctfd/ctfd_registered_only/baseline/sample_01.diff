+def registered_only(f):
+    """
+    Decorator that redirects anonymous users to the register page
+    :param f:
+    :return:
+    """
+
+    @functools.wraps(f)
+    def registered_only_wrapper(*args, **kwargs):
+        if authed():
+            return f(*args, **kwargs)
+        else:
+            if request.is_json or request.accept_mimetypes.best == "text/event-stream":
+                abort(403)
+            else:
+                return redirect(url_for("auth.register", next=request.full_path))
+
+    return registered_only_wrapper
+
+
