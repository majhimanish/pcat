+def ratelimit(method="POST", limit=50, interval=300, key_prefix="rl"):
+    """
+    Limit requests of the given HTTP method to `limit` per `interval` seconds
+    for each client IP address and endpoint. Over-limit requests receive a 429.
+    """
+
+    def ratelimit_decorator(f):
+        @functools.wraps(f)
+        def decorated_function(*args, **kwargs):
+            if request.method == method:
+                key = "{}:{}:{}".format(key_prefix, get_ip(), request.endpoint)
+                current = cache.get(key)
+                if current is not None and int(current) >= limit:
+                    resp = jsonify(
+                        {
+                            "code": 429,
+                            "message": "Too many requests. Limit is {} requests in {} seconds".format(
+                                limit, interval
+                            ),
+                        }
+                    )
+                    resp.status_code = 429
+                    return resp
+                if current is None:
+                    cache.set(key, 1, timeout=interval)
+                else:
+                    cache.set(key, int(current) + 1, timeout=interval)
+            return f(*args, **kwargs)
+
+        return decorated_function
+
+    return ratelimit_decorator
