+def ratelimit(method="POST", limit=50, interval=300, key_prefix="rl"):
+    """
+    Limit how many requests of a given HTTP method a single client IP can make
+    to an endpoint within `interval` seconds. Excess requests receive a 429.
+    :param method: HTTP method to limit (other methods pass through)
+    :param limit: max requests allowed per window
+    :param interval: window length in seconds
+    """
+
+    def ratelimit_decorator(f):
+        @functools.wraps(f)
+        def decorated_function(*args, **kwargs):
+            if request.method != method:
+                return f(*args, **kwargs)
+
+            key = f"{key_prefix}:{request.endpoint}:{get_ip()}:{request.method}"
+            count = cache.get(key)
+
+            if count is not None and int(count) >= limit:
+                # Refresh the window so continued hammering keeps the block active
+                cache.set(key, int(count), timeout=interval)
+                if request.is_json:
+                    resp = jsonify(
+                        {
+                            "success": False,
+                            "errors": {
+                                "": ["Too many requests. Please try again later."]
+                            },
+                        }
+                    )
+                    resp.status_code = 429
+                    return resp
+                return render_template("errors/429.html"), 429
+
+            if count is None:
+                cache.set(key, 1, timeout=interval)
+            else:
+                try:
+                    cache.inc(key)
+                except NotImplementedError:
+                    cache.set(key, int(count) + 1, timeout=interval)
+            return f(*args, **kwargs)
+
+        return decorated_function
+
+    return ratelimit_decorator
