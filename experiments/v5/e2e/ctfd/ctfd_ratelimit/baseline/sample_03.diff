+def ratelimit(method="POST", limit=50, interval=300, key_prefix="rl"):
+    """
+    Limit requests of the given HTTP method to `limit` per `interval` seconds, per client IP and endpoint.
+    Requests over the limit receive a 429 response. Other HTTP methods are not counted.
+    """
+
+    def ratelimit_decorator(f):
+        @functools.wraps(f)
+        def decorated_function(*args, **kwargs):
+            if request.method == method:
+                key = "{}:{}:{}".format(
+                    key_prefix, current_user.get_ip(), request.endpoint
+                )
+                current = cache.get(key)
+
+                if current and int(current) >= limit:
+                    return (
+                        jsonify(
+                            {
+                                "code": 429,
+                                "message": "Too many requests. Limit is %s requests in %s seconds"
+                                % (limit, interval),
+                            }
+                        ),
+                        429,
+                    )
+                # Fixed window: the timer starts on the first counted request
+                if current is None:
+                    cache.set(key, 1, timeout=interval)
+                else:
+                    cache.set(key, int(current) + 1, timeout=interval)
+            return f(*args, **kwargs)
+
+        return decorated_function
+
+    return ratelimit_decorator
+
